{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/.svelte-kit",
      "!!**/build",
      "!!**/coverage",
      "!!data",
      "!!.agents",
      "!!.gjc",
      "!!.omc",
      "!!.omx",
      "!tests/fixtures/pricing/public-pricing.html",
      "!**/.svelte-check"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "preset": "recommended"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "none"
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": [
        "src/lib/components/gallery/GalleryViewer.svelte",
        "src/lib/components/studio/StudioWorkspace.svelte"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveTabindex": "off",
            "useMediaCaption": "off",
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": ["src/lib/components/library/MediaPreview.svelte"],
      "linter": {
        "rules": {
          "a11y": {
            "useAnchorContent": "off",
            "useMediaCaption": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/lib/components/library/JobDetailView.svelte",
        "src/lib/components/studio/BatchReview.svelte",
        "src/lib/components/studio/StudioScaffold.svelte",
        "src/routes/gallery/+page.svelte"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/routes/gallery/+page.svelte",
        "src/lib/components/studio/AspectRatioField.svelte",
        "src/lib/components/studio/StudioWorkspace.svelte",
        "src/lib/components/shell/AppShell.svelte",
        "src/lib/components/library/JobDetailView.svelte"
      ],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
